# Copy to .env and fill in. Never commit .env.

# Google Analytics 4 measurement ID. Optional: GA is skipped when empty.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Freelance brief form (/api/brief), sent with Resend: https://resend.com
# Without these the form opens the visitor's mail app instead.
RESEND_API_KEY=
# Inbox that receives project briefs.
BRIEF_TO_EMAIL=
# Sender on a domain verified in Resend. Leave empty to use Resend's test sender,
# which only delivers to your own Resend account email.
BRIEF_FROM_EMAIL=

# Google Sheet that logs every brief, via an Apps Script web app bound to the Sheet.
# Optional and independent of Resend: the form works when either one is set up.
# Web app URL ending in /exec.
SHEETS_WEBHOOK_URL=
# Long random string; must match BRIEF_SECRET in the script's Script properties.
SHEETS_WEBHOOK_SECRET=

# Cloudflare Turnstile spam check for the brief form: https://dash.cloudflare.com > Turnstile > Add widget.
# Optional: both empty turns it off. Set both or neither. For local testing, Cloudflare's always-pass
# test keys are 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Cal.com event for the free call, as "username/event" (e.g. daffa-aditya/30min). Set the event's
# location to Google Meet in Cal.com so every booking gets a Meet room. Empty hides booking on the site.
NEXT_PUBLIC_CAL_LINK=
